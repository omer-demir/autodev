{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries", "title": "Log volume by service", "id": 1,
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum by (service_name) (count_over_time({service_name=~\"$service\"}[$__auto]))", "legendFormat": "{{service_name}}", "queryType": "range"}]
    },
    {
      "type": "stat", "title": "Error-like lines", "id": 2,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum(count_over_time({service_name=~\"$service\"} |~ \"(?i)error|fatal|panic|exception\" [$__auto]))", "legendFormat": "errors"}]
    },
    {
      "type": "logs", "title": "Selected service logs", "id": 3,
      "gridPos": {"h": 12, "w": 14, "x": 0, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=~\"$service\"}", "refId": "A"}],
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"}
    },
    {
      "type": "logs", "title": "Errors and exceptions", "id": 4,
      "gridPos": {"h": 12, "w": 10, "x": 14, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=~\"$service\"} |~ \"(?i)error|fatal|panic|exception\"", "refId": "A"}],
      "options": {"showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"}
    },
    {
      "type": "logs", "title": "Trace-correlated application logs", "id": 5,
      "description": "Use the TraceID derived field beside a JSON log line to open the corresponding Tempo trace.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=~\"api|worker|web\"} | json | trace_id != \"\"", "refId": "A"}],
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"}
    }
  ],
  "schemaVersion": 42,
  "tags": ["autodev", "logs", "loki"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service_name)",
        "definition": "label_values(service_name)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "title": "AutoDev Logs",
  "uid": "autodev-logs",
  "version": 1
}
