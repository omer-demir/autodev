WORKBENCH_API_URL=http://127.0.0.1:8000
WORKBENCH_CREDENTIAL_PROVIDER=encrypted_database
# Generate a stable high-entropy value for non-development deployments. Back it up with the database.
WORKBENCH_CREDENTIAL_MASTER_KEY=autodev-local-development-only
NEXT_PUBLIC_API_URL=
WORKBENCH_DATABASE_URL=postgresql+psycopg://autodev:autodev-local@127.0.0.1:5432/autodev
WORKBENCH_EXECUTION_DISPATCH=durable
WORKBENCH_WORKER_POLL_SECONDS=1
WORKBENCH_WORKER_LEASE_SECONDS=60
WORKBENCH_WORKER_HEARTBEAT_SECONDS=15
WORKBENCH_REDIS_URL=redis://127.0.0.1:6379/0
WORKBENCH_EVENT_STREAM_NAME=autodev:events
WORKBENCH_WORKSPACE_SNAPSHOT_PROVIDER=local
WORKBENCH_WORKSPACE_SNAPSHOT_REQUIRED=false
WORKBENCH_WORKSPACE_SNAPSHOT_DIR=.snapshots
WORKBENCH_AZURE_STORAGE_CONNECTION_STRING=
WORKBENCH_AZURE_STORAGE_ACCOUNT_URL=
WORKBENCH_WORKSPACE_SNAPSHOT_CONTAINER=autodev-workspaces
WORKBENCH_EVIDENCE_PROVIDER=local
WORKBENCH_EVIDENCE_CONTAINER=autodev-evidence
WORKBENCH_EXECUTION_MODE=real
WORKBENCH_GOVERNANCE_PROVIDER=agent_os
WORKBENCH_RUNTIME_SUPERVISOR_PROVIDER=microsoft_agent_hypervisor
WORKBENCH_RUNTIME_SUPERVISOR_DEFAULT_TRUST=0.7
WORKBENCH_PROMPT_DEFENSE_MIN_GRADE=C
WORKBENCH_AGENT_IDENTITY_DIR=.agentmesh
WORKBENCH_COPILOT_HOME=~/.copilot
WORKBENCH_MODEL_PROVIDER=ollama
WORKBENCH_MODEL_NAME=gemma4:e2b
WORKBENCH_MODEL_FALLBACK_PROVIDER=ollama
WORKBENCH_MODEL_FALLBACK_NAME=gemma4:e2b
WORKBENCH_EVALUATOR_PROVIDER=ollama
WORKBENCH_EVALUATOR_MODEL=gemma4:e2b
WORKBENCH_AGENT_TURN_TIMEOUT_SECONDS=1800
WORKBENCH_SANDBOX_COMMAND_TIMEOUT_SECONDS=1800
WORKBENCH_OLLAMA_URL=http://127.0.0.1:11434
WORKBENCH_GITHUB_TOKEN=
WORKBENCH_GITHUB_OAUTH_CLIENT_ID=
WORKBENCH_GITHUB_OAUTH_CLIENT_SECRET=
WORKBENCH_GITHUB_OAUTH_SCOPE=read:user repo
WORKBENCH_GITHUB_APP_ID=
WORKBENCH_GITHUB_APP_SLUG=
WORKBENCH_GITHUB_APP_CLIENT_ID=
WORKBENCH_GITHUB_APP_CLIENT_SECRET=
WORKBENCH_GITHUB_APP_PRIVATE_KEY=
WORKBENCH_GITHUB_APP_PRIVATE_KEY_FILE=
WORKBENCH_WEB_APP_URL=http://localhost:3000
WORKBENCH_WEB_EDITOR_URL=
WORKBENCH_AUTH_MODE=local
WORKBENCH_LOCAL_USER_ID=local-admin
WORKBENCH_LOCAL_ORGANIZATION_ID=local
WORKBENCH_OIDC_ISSUER=
WORKBENCH_OIDC_AUDIENCE=
WORKBENCH_OIDC_JWKS_URL=
WORKBENCH_OIDC_AUTHORIZATION_URL=
WORKBENCH_OIDC_TOKEN_URL=
WORKBENCH_OIDC_CLIENT_ID=
WORKBENCH_OIDC_CLIENT_SECRET=
WORKBENCH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKBENCH_OIDC_SCOPES=openid profile email
WORKBENCH_OIDC_ALGORITHMS=RS256,ES256
WORKBENCH_OIDC_ORGANIZATION_CLAIM=org_id
WORKBENCH_OIDC_ROLES_CLAIM=roles
WORKBENCH_OIDC_AUTO_PROVISION=true
WORKBENCH_SESSION_TTL_HOURS=8
